# Copy to .env and fill in. Never commit .env, never paste keys in chat.
# Free mode (default) needs only this one:
GEMINI_API_KEY=            # free Google AI Studio key (aistudio.google.com/apikey), no billing; used for the Tamil voice
# Only if you switch providers in config.yaml:
GOOGLE_TTS_API_KEY=        # Google Cloud Text-to-Speech (needs Cloud billing)
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Phase 4 (publishing)
YOUTUBE_CLIENT_SECRETS_FILE=credentials/youtube_client_secret.json
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Optional overrides
REVIEW_GATE=true
DRY_RUN=false
