# Copy to .env and fill in. Never commit .env, never paste keys in chat.
# Free mode (default) needs only this one:
GOOGLE_TTS_API_KEY=        # Google Cloud API key with the Text-to-Speech API enabled (free tier)
# Paid providers, only if you switch to them in config.yaml:
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# Phase 4 (publishing)
YOUTUBE_CLIENT_SECRETS_FILE=credentials/youtube_client_secret.json
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Optional overrides
REVIEW_GATE=true
DRY_RUN=false
